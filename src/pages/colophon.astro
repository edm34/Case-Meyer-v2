---
import Base from '../layouts/Base.astro';
---
<Base title="Colophon" description="About this site.">
  <section class="section">
    <div class="wrap">
      <p class="t-label t-grey">Colophon</p>
      <div class="row" style="margin-top:24px">
        <p class="t-label t-grey">Images</p>
        <div class="prose t-md">
          <p>Drawings by Luis Barragán reproduced from the originals held by the family. Photographs from the family collection unless otherwise credited.</p>
        </div>
      </div>
      <div class="row">
        <p class="t-label t-grey">Design</p>
        <div class="prose t-md">
          <p>The site is set in a grotesk sans-serif and uses the colours of the house: the yellow of the gate, the pink of the lattice, the white of the walls and the one green square.</p>
        </div>
      </div>
      <div class="row">
        <p class="t-label t-grey">Contact</p>
        <div class="prose t-md">
          <p>[Contact details to be confirmed.]</p>
        </div>
      </div>
    </div>
  </section>
</Base>
