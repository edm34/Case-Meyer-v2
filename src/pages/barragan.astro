---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { url } from '../lib/url';
const chronology = (await getCollection('chronology')).map((c) => c.data);
---
<Base title="Luis Barragán" description="Luis Barragán, 1902–1988: a short biography and chronology.">
  <section class="section">
    <div class="wrap">
      <p class="t-label t-grey">Luis Barragán</p>
      <h1 class="t-xl" style="margin-top:16px;max-width:14ch">1902 – 1988</h1>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="row">
        <p class="t-label t-grey reveal">Biography</p>
        <div class="prose t-md reveal">
          <p>Luis Barragán was born in Guadalajara in 1902 and trained as an engineer. He taught himself architecture by travelling: the gardens of the Mediterranean, the Alhambra, the writings of Ferdinand Bac, the lectures of Le Corbusier. He settled in Mexico City in 1936 and, after a decade of functionalist apartment buildings, withdrew from commercial practice to work on his own terms.</p>
          <p>What followed was a small number of houses, gardens, chapels and stables, most of them in and around the capital, built from thick walls, still water and colour. Barragán spoke of serenity, silence and solitude as the qualities a house should offer. He received the Pritzker Prize in 1980 and died in his own house in Tacubaya in 1988.</p>
          <p>Casa Meyer, drawn in October 1978, is the last house he designed.</p>
        </div>
      </div>
      <div class="row">
        <p class="t-label t-grey reveal">In his words</p>
        <blockquote class="t-lg reveal" style="max-width:30ch">
          <p>“Any work of architecture which does not express serenity is a mistake.”</p>
          <footer class="t-sm t-grey" style="margin-top:16px">Pritzker Prize acceptance speech, 1980</footer>
        </blockquote>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="row">
        <p class="t-label t-grey">Chronology</p>
        <ol class="chron">
          {chronology.map((c) => (
            <li class:list={['chron__item reveal', { 'chron__item--casa': c.casaMeyer }]}>
              <span class="chron__year">{c.year}</span>
              <div>
                <h3 class="t-md">{c.title}</h3>
                <p class="t-sm t-grey" style="margin-top:6px;max-width:60ch">{c.text}</p>
                {c.casaMeyer && <p style="margin-top:10px"><a class="t-label" href={url('/casa/')}>The house →</a></p>}
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>
</Base>
<style>
  .chron { border-top: 1px solid var(--rule); }
  .chron__item { display: grid; grid-template-columns: 5.5rem 1fr; gap: 12px var(--gutter); padding: 18px 0; border-bottom: 1px solid var(--rule); }
  .chron__year { font-variant-numeric: tabular-nums; color: var(--grey); font-size: 0.85rem; padding-top: 4px; }
  .chron__item--casa { background: linear-gradient(to right, var(--yellow) 0, var(--yellow) 6px, transparent 6px); padding-left: 18px; }
  .chron__item--casa .chron__year { color: var(--black); }
  .chron__item a:hover { color: var(--pink); }
</style>
