---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const items = (await getCollection('archive')).sort((a, b) => a.data.order - b.data.order);
  return items.map((it, i) => ({
    params: { slug: it.id },
    props: { entry: it, prev: items[i - 1] ?? items[items.length - 1], next: items[i + 1] ?? items[0] },
  }));
}
const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const meta: [string, string | undefined][] = [
  ['Date', d.date], ['Author', d.author], ['Medium', d.medium], ['Dimensions', d.dimensions], ['Inscription', d.inscription],
];
---
<Base title={d.title} description={`${d.title}, ${d.type} from the Casa Meyer archive.`} image={d.image.src}>
  <section class="section" style="padding-bottom:0">
    <div class="wrap">
      <p class="t-label t-grey"><a href={url('/archive/')}>Archive</a> &nbsp;/&nbsp; {d.type}</p>
    </div>
  </section>
  <figure class="figure" style="padding:24px var(--gutter) 0">
    <img src={url(d.image.src)} alt={d.image.alt} loading="eager" fetchpriority="high" style="max-height:84vh;width:auto;max-width:100%;margin:0 auto;background:transparent" />
  </figure>
  <section class="section">
    <div class="wrap">
      <div class="row" style="border-top:0">
        <h1 class="t-lg">{d.title}</h1>
        <div>
          <dl class="meta">
            {meta.filter(([, v]) => v).map(([k, v]) => (<><dt class="t-label t-grey">{k}</dt><dd class="t-sm">{v}</dd></>))}
          </dl>
          <div class="prose t-md" style="margin-top:28px"><Content /></div>
        </div>
      </div>
      <div class="row">
        <p class="t-label t-grey">Archive</p>
        <div class="pager__links">
          <a href={url(`/archive/${prev.id}/`)} class="t-md">← {prev.data.title}</a>
          <a href={url(`/archive/${next.id}/`)} class="t-md">{next.data.title} →</a>
        </div>
      </div>
    </div>
  </section>
</Base>
<style>
  .meta { display: grid; grid-template-columns: 8rem 1fr; gap: 8px var(--gutter); border-top: 1px solid var(--rule); padding-top: 12px; }
  .pager__links { display: flex; justify-content: space-between; gap: var(--gutter); flex-wrap: wrap; }
  .pager__links a:hover { color: var(--pink); }
</style>
