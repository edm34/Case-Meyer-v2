---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { url } from '../../lib/url';
const items = (await getCollection('archive')).sort((a, b) => a.data.order - b.data.order);
const types = ['drawing', 'photograph', 'watercolor', 'document'] as const;
const labels: Record<string, string> = { drawing: 'Drawings', photograph: 'Photographs', watercolor: 'Watercolors', document: 'Documents' };
---
<Base title="Archive" description="Drawings, photographs and documents relating to Casa Meyer.">
  <section class="section">
    <div class="wrap">
      <p class="t-label t-grey">Archive</p>
      <h1 class="t-xl" style="margin-top:16px;max-width:20ch">Drawings, photographs, documents.</h1>
    </div>
  </section>
  {types.map((t) => {
    const group = items.filter((i) => i.data.type === t);
    if (!group.length) return null;
    return (
      <section class="section">
        <div class="wrap">
          <div class="row">
            <p class="t-label t-grey">{labels[t]}</p>
            <ul class="index">
              {group.map((i) => (
                <li>
                  <a class="index__item" href={url(`/archive/${i.id}/`)}>
                    <span class="index__num">{String(i.data.order).padStart(2, '0')}</span>
                    <span class="index__title">{i.data.title}</span>
                    <span class="index__meta">{i.data.date ?? i.data.author ?? ''}</span>
                    <img class="index__thumb" src={url(i.data.image.src)} alt="" loading="lazy" />
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>
    );
  })}
</Base>
