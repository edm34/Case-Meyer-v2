---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { url } from '../../lib/url';
const spaces = (await getCollection('spaces')).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Spaces" description="The walls, rooms and garden of Casa Meyer.">
  <section class="section">
    <div class="wrap">
      <p class="t-label t-grey">Spaces</p>
      <h1 class="t-xl" style="margin-top:16px;max-width:20ch">The house, wall by wall.</h1>
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      <ul class="tiles">
        {spaces.map((s, i) => (
          <li class="reveal">
            <a class="tile" href={url(`/spaces/${s.id}/`)}>
              <img src={url(s.data.cover.src)} alt={s.data.cover.alt} loading={i < 3 ? 'eager' : 'lazy'} />
              <p class="tile__cap"><span>{String(i + 1).padStart(2, '0')}&nbsp; {s.data.title}</span><span>{s.data.subtitle}</span></p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
