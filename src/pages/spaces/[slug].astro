---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const spaces = (await getCollection('spaces')).sort((a, b) => a.data.order - b.data.order);
  return spaces.map((s, i) => ({
    params: { slug: s.id },
    props: { entry: s, index: i, prev: spaces[i - 1] ?? spaces[spaces.length - 1], next: spaces[i + 1] ?? spaces[0] },
  }));
}
const { entry, index, prev, next } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---
<Base title={d.title} description={`${d.title} — ${d.subtitle ?? ''} at Casa Meyer.`} image={d.cover.src}>
  <figure class="figure hero">
    <img src={url(d.cover.src)} alt={d.cover.alt} loading="eager" fetchpriority="high" />
  </figure>
  <section class="section">
    <div class="wrap">
      <div class="row" style="border-top:0;padding-top:0">
        <div>
          <p class="t-label t-grey">{String(index + 1).padStart(2, '0')} &nbsp;{d.subtitle}</p>
          {d.year && <p class="t-sm t-grey" style="margin-top:6px">{d.year}</p>}
        </div>
        <div>
          <h1 class="t-lg">{d.title}</h1>
          <div class="prose t-md" style="margin-top:28px"><Content /></div>
          {d.placeholder && <p class="t-sm" style="margin-top:28px;padding:12px 14px;background:var(--pink-paper);display:inline-block">Photographs for this space are still to come.</p>}
        </div>
      </div>
      {d.gallery.length > 0 && (
        <div class="row">
          <p class="t-label t-grey">Images</p>
          <div class="tiles" style="grid-template-columns:1fr">
            {d.gallery.map((g) => (
              <figure class="figure reveal">
                <img src={url(g.src)} alt={g.alt} loading="lazy" />
                {g.caption && <figcaption><span>{g.caption}</span><span>{g.credit}</span></figcaption>}
              </figure>
            ))}
          </div>
        </div>
      )}
      <div class="row pager">
        <p class="t-label t-grey">Spaces</p>
        <div class="pager__links">
          <a href={url(`/spaces/${prev.id}/`)} class="t-md">← {prev.data.title}</a>
          <a href={url(`/spaces/${next.id}/`)} class="t-md">{next.data.title} →</a>
        </div>
      </div>
    </div>
  </section>
</Base>
<style>
  .hero img { width: 100%; max-height: 82vh; object-fit: cover; }
  .pager__links { display: flex; justify-content: space-between; gap: var(--gutter); flex-wrap: wrap; }
  .pager__links a:hover { color: var(--pink); }
</style>
