---
/**
 * The split wordmark is the navigation: one large word in each top corner,
 * a second link that slides in beneath on hover, a round bullet as the only
 * state indicator. Scroll-linked shrink via --hp (set in Base.astro).
 */
import { brand, corners, firstChildPath } from '../lib/site';
import { url } from '../lib/url';
const { activeSection = '', variant = 'page' } = Astro.props as { activeSection?: string; variant?: 'home' | 'page' | 'detail' };
const L = corners.left, R = corners.right;
const cur = (key: string) => (activeSection === key ? 'true' : undefined);
---
<header class:list={['hdr', `hdr--${variant}`]}>
  <div class="hdr__side hdr__side--left">
    <a class="hdr__word hdr__word--primary" href={url(firstChildPath(L.primary))} aria-current={cur(L.primary.key)} aria-label={`${L.primary.label}: ${L.primary.children[0].label}`}>
      <span class="hdr__dot" aria-hidden="true">●</span><span class="hdr__reveal" aria-hidden="true">{brand.leftPrefix}</span>{brand.left}
    </a>
    <a class="hdr__word hdr__word--secondary" href={url(firstChildPath(L.secondary))} aria-current={cur(L.secondary.key)}>
      <span class="hdr__dot" aria-hidden="true">●</span>{L.secondary.label}
    </a>
  </div>
  <div class="hdr__side hdr__side--right">
    <a class="hdr__word hdr__word--primary" href={url(firstChildPath(R.primary))} aria-current={cur(R.primary.key)}>
      <span class="hdr__dot" aria-hidden="true">●</span>{brand.right}
    </a>
    <a class="hdr__word hdr__word--secondary" href={url(firstChildPath(R.secondary))} aria-current={cur(R.secondary.key)}>
      <span class="hdr__dot" aria-hidden="true">●</span>{R.secondary.label}
    </a>
  </div>
  <div class="hdr__bar" aria-hidden="true"></div>
</header>

<style>
  /* Each side is a fixed hover region that covers both of its words, so the
     pointer can travel from the primary word down to the slid-in link. */
  .hdr__side { position: fixed; top: 0; z-index: 1002; width: 30vw; height: calc(12rem - 6rem * var(--hp)); }
  .hdr__side--left { left: 0; }
  .hdr__side--right { right: 0; }
  .hdr__word {
    position: fixed; z-index: 1010; white-space: nowrap; color: var(--ink);
    font-family: var(--font-sans); letter-spacing: -.05em; font-weight: 400;
    font-size: calc(5rem - 2.5rem * var(--hp));
    line-height: calc(5.5rem - 1.5rem * var(--hp));
  }
  .hdr__side--left  .hdr__word { left: var(--edge); }
  .hdr__side--right .hdr__word { right: var(--edge); text-align: right; }
  .hdr__word--primary   { top: 1rem; }
  .hdr__word--secondary { top: calc(6rem - 2.1rem * var(--hp)); z-index: 1003; transition: transform var(--t-hover); }
  .hdr__side--left  .hdr__word--secondary { transform: translateX(-150%); }
  .hdr__side--right .hdr__word--secondary { transform: translateX(150%); }
  .hdr__side:hover .hdr__word--secondary,
  .hdr__side:focus-within .hdr__word--secondary,
  .hdr__word--secondary[aria-current] { transform: none; }

  .hdr__dot, .hdr__reveal {
    display: inline-block; vertical-align: top; overflow: hidden; max-width: 0;
    transition: max-width var(--t-hover), padding var(--t-hover);
  }
  .hdr__dot { color: var(--accent); }
  .hdr__word:hover .hdr__dot, .hdr__word:focus-visible .hdr__dot, .hdr__word[aria-current] .hdr__dot { max-width: 5rem; }
  .hdr__word:hover .hdr__reveal, .hdr__word:focus-visible .hdr__reveal { max-width: 20rem; padding-right: 1rem; }

  .hdr__bar {
    position: fixed; z-index: 1000; top: -2rem; left: -10%; width: 120%; height: 6rem;
    background: var(--paper); box-shadow: 0 2rem 1rem var(--paper);
  }
  .hdr--home .hdr__bar { display: none; }
  .hdr--detail .hdr__bar { height: 10rem; }

  @media (max-width: 767px) {
    .hdr__side { position: static; width: auto; height: auto; }
    .hdr__word { font-size: 2.5rem; line-height: 1.1; }
    .hdr__side .hdr__word--secondary { top: 4rem; transition: transform .6s; }
    html.is-ready .hdr__side .hdr__word--secondary { transform: none; }
    .hdr__bar, .hdr--home .hdr__bar { display: block; height: 9rem; }
  }
</style>
