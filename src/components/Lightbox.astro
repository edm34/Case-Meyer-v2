---
/** Desktop lightbox for side images and list thumbnails. */
---
<dialog class="lightbox" id="lightbox" aria-label="Image">
  <button class="lightbox__close" id="lightboxClose" aria-label="Close"></button>
  <figure>
    <img id="lightboxImg" src="" alt="" />
    <figcaption id="lightboxCap"></figcaption>
  </figure>
</dialog>
<style>
  .lightbox { position: fixed; inset: 0; width: 100vw; height: 100vh; max-width: none; max-height: none; margin: 0; padding: 5rem; border: 0; background: var(--paper); z-index: 10000; }
  .lightbox::backdrop { background: transparent; }
  .lightbox figure { height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; }
  .lightbox img { max-height: 80vh; width: auto; max-width: 100%; object-fit: contain; cursor: pointer; }
  .lightbox figcaption { text-align: center; padding: 1rem 0; }
  .lightbox__close { position: absolute; top: 1rem; right: 1rem; width: 3rem; height: 3rem; }
  .lightbox__close::before, .lightbox__close::after { content: ""; position: absolute; left: 0; right: 0; top: 50%; height: 1px; background: var(--black); }
  .lightbox__close::before { transform: rotate(45deg); }
  .lightbox__close::after { transform: rotate(-45deg); }
  @media (max-width: 767px) { .lightbox { display: none !important; } }
</style>
<script>
  (function () {
    const dlg = document.getElementById('lightbox') as HTMLDialogElement | null;
    if (!dlg) return;
    const img = document.getElementById('lightboxImg') as HTMLImageElement;
    const cap = document.getElementById('lightboxCap') as HTMLElement;
    const open = (src: string, alt: string, caption: string) => {
      if (matchMedia('(max-width: 767px)').matches) return;
      img.src = src; img.alt = alt; cap.textContent = caption; dlg.showModal();
    };
    document.querySelectorAll<HTMLImageElement>('[data-lightbox] img').forEach((el) => {
      el.addEventListener('click', () => {
        const fig = el.closest('figure');
        const c = fig?.querySelector('figcaption')?.textContent?.trim() ?? '';
        open(el.currentSrc || el.src, el.alt, c);
      });
    });
    img.addEventListener('click', () => dlg.close());
    document.getElementById('lightboxClose')?.addEventListener('click', () => dlg.close());
  })();
</script>
