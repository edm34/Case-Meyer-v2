---
/**
 * Home sequence: full-viewport images, one after another, each with a thin
 * caption bar. Scroll, arrow keys or a click advance through them.
 */
import { url } from '../lib/url';
interface Slide { id: string; src: string; alt: string; caption: string; href?: string; tone: 'light' | 'dark' }
const { slides } = Astro.props as { slides: Slide[] };
---
<section class="show" id="show" aria-label="Casa Meyer in pictures">
  {slides.map((s, i) => (
    <article class:list={['show__slide', `show__slide--${s.tone}`]} id={`slide-${s.id}`} data-index={i}>
      <img src={url(s.src)} alt={s.alt} loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} decoding="async" />
      <div class="show__bar">
        <p class="show__caption t-sm">{s.href ? <a href={url(s.href)}>{s.caption}</a> : s.caption}</p>
        <p class="show__count t-sm"><span class="tab">{String(i + 1).padStart(2, '0')}</span> / {String(slides.length).padStart(2, '0')}</p>
      </div>
    </article>
  ))}
  <button class="show__next t-label" id="showNext" aria-label="Next image">Next</button>
</section>

<style>
  .show { position: relative; }
  .show__slide {
    position: relative;
    height: calc(100svh - var(--header-h)); min-height: 440px;
    scroll-snap-align: start;
    background: var(--paper);
  }
  .show__slide img { width: 100%; height: 100%; object-fit: cover; }
  .show__slide:first-child img { object-position: 50% 60%; }
  .show__bar {
    position: absolute; left: 0; right: 0; bottom: 0;
    display: flex; justify-content: space-between; gap: var(--gutter);
    padding: 12px var(--gutter);
    background: var(--white);
    border-top: 1px solid var(--rule);
  }
  .show__caption a:hover { color: var(--pink); }
  .show__count { color: var(--grey); font-variant-numeric: tabular-nums; }
  .show__next {
    position: fixed; right: var(--gutter); bottom: 64px; z-index: 20;
    background: var(--yellow); padding: 12px 16px;
    opacity: 0; transition: opacity 0.4s var(--ease);
  }
  .show__next.is-visible { opacity: 1; }
  .show__next:hover { background: var(--black); color: var(--white); }
  @media (max-width: 767px) { .show__next { display: none; } }
</style>

<script>
  function initShow() {
    const show = document.getElementById('show');
    const next = document.getElementById('showNext');
    if (!show || !next) return;
    const slides = Array.from(show.querySelectorAll<HTMLElement>('.show__slide'));
    const headerH = 56;
    const current = () => {
      const y = window.scrollY + headerH + 1;
      let idx = 0;
      slides.forEach((s, i) => { if (s.offsetTop <= y) idx = i; });
      return idx;
    };
    const go = (i: number) => {
      const t = slides[Math.min(Math.max(i, 0), slides.length - 1)];
      window.scrollTo({ top: t.offsetTop - headerH, behavior: 'smooth' });
    };
    next.addEventListener('click', () => go(current() + 1));
    const onScroll = () => {
      const rect = show.getBoundingClientRect();
      const inside = rect.bottom > window.innerHeight * 0.6;
      next.classList.toggle('is-visible', inside && current() < slides.length - 1);
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown' || e.key === ' ') {
        if (show.getBoundingClientRect().bottom > window.innerHeight * 0.6) { e.preventDefault(); go(current() + 1); }
      }
      if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
        if (show.getBoundingClientRect().bottom > window.innerHeight * 0.6) { e.preventDefault(); go(current() - 1); }
      }
    });
  }
  initShow();
  document.addEventListener('astro:page-load', initShow);
</script>
