---
import { sections, legal, brand } from '../lib/site';
import { url } from '../lib/url';
const { flush = false } = Astro.props as { flush?: boolean };
const year = new Date().getFullYear();
---
<footer class:list={['ftr', { 'ftr--flush': flush }]}>
  <div class="ftr__nav">
    {sections.map((s) => (
      <nav aria-label={s.label}>
        <h2>{s.label}</h2>
        <ul>{s.children.map((c) => <li><a href={url(`/${s.slug}/${c.slug}/`)}>{c.label}</a></li>)}</ul>
      </nav>
    ))}
  </div>
  <p class="ftr__legal">
    {legal.map((l, i) => <><a href={url(`/${l.slug}/`)}>{l.label}</a>{' — '}</>)}
    © {brand.name} {year}. Drawings and photographs reproduced by permission of the family.
  </p>
</footer>
<style>
  .ftr { display: flex; flex-wrap: wrap; justify-content: center; border-top: 1px solid var(--black); margin: 5rem 0 2rem; }
  .ftr--flush { margin-top: 0; }
  .ftr__nav { display: flex; width: var(--col-6); padding-top: 3rem; }
  .ftr__nav nav { width: 25%; }
  .ftr__nav h2 { font-size: 1rem; margin: 0 0 .2rem; color: var(--black); }
  .ftr__nav li { font-size: 1rem; line-height: 1.3; }
  .ftr__nav a, .ftr__legal, .ftr__legal a { color: var(--grey); }
  .ftr__nav a:hover, .ftr__legal a:hover { color: var(--black); }
  .ftr__legal { width: var(--col-7); margin: 3rem 0 0; text-align: center; font-size: .8rem; line-height: 1.2; }
  @media (max-width: 767px) {
    .ftr { margin: 5rem 0 1rem; padding: 0 1rem; }
    .ftr__nav { width: 100%; flex-wrap: wrap; padding-top: 0; }
    .ftr__nav nav { width: 50%; margin-top: 2rem; }
    .ftr__nav h2, .ftr__nav li { font-size: 1.5rem; }
    .ftr__legal { width: 100%; font-size: max(.8rem, 12px); }
  }
</style>
